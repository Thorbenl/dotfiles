{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "ENABLE_LSP_TOOL": "1",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "permissions": {
    "allow": [
      "Bash(npx gsd-core *)",
      "Read(.planning/*)",
      "Write(.planning/*)",
      "Read(STATE.md)",
      "Write(STATE.md)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(secrets.json)",
      "Read(id_rsa)",
      "Read(credentials.json)",
      "Read(.env.*)",
      "Read(.secrets)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/block-secrets.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check-gh-auth.sh"
          }
        ]
      },
      {
        "matcher": "mcp__atlassian",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check-atlassian-auth.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/dkThoLue/.local/share/mise/installs/node/24.12.0/bin/node\" \"/Users/dkThoLue/.claude/hooks/gsd-worktree-path-guard.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/Users/dkThoLue/.claude/hooks/gsd-graphify-update.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/dkThoLue/.claude/hooks/vault-system-reminder.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "oh-my-claudecode@omc": false,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "figma@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "pr-review-toolkit@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false,
    "csharp-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "xclaude-plugin@xclaude-plugin-marketplace": false,
    "claude-md-management@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "codex@openai-codex": true,
    "claude-mem@thedotmack": true,
    "user-story@pm-skills": false,
    "watch@claude-video": true,
    "simple-english@simple-english": true,
    "assessments@CMT-lumen-assessments": true
  },
  "extraKnownMarketplaces": {
